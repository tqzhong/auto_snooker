{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/components/**", "src/renderer/**", "src/main.tsx"]
}
